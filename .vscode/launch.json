{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Tauri Development",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}/src-tauri/target/debug/prescriptx",
      "processId": "${command:pickProcess}",
      "sourceMap": {
        "/cargo/registry": "${env:USERPROFILE}/.cargo/registry",
        "/cargo/git": "${env:USERPROFILE}/.cargo/git"
      },
      "preLaunchTask": ""
    },
    {
      "name": "Debug Renderer (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}/src/renderer",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug All (Tauri + Renderer)",
      "configurations": ["Launch Tauri Development", "Debug Renderer (Chrome)"],
      "presentation": {
        "order": 1
      }
    }
  ]
}
